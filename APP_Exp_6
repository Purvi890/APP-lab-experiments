def knapsack_bottom_up(weights, profits, W):
    n = len(weights)

    dp = [[0] * (W + 1) for _ in range(n + 1)]

    for i in range(1, n + 1):
        for w in range(W + 1):
            if weights[i - 1] <= w:
                dp[i][w] = max(
                    profits[i - 1] + dp[i - 1][w - weights[i - 1]],
                    dp[i - 1][w]
                )
            else:
                dp[i][w] = dp[i - 1][w]

    return dp[n][W]


def knapsack_top_down(weights, profits, n, W, memo):
    if n == 0 or W == 0:
        return 0

    if memo[n][W] != -1:
        return memo[n][W]

    if weights[n - 1] > W:
        memo[n][W] = knapsack_top_down(
            weights, profits, n - 1, W, memo
        )
    else:
        include = profits[n - 1] + knapsack_top_down(
            weights, profits, n - 1,
            W - weights[n - 1], memo
        )

        exclude = knapsack_top_down(
            weights, profits, n - 1, W, memo
        )

        memo[n][W] = max(include, exclude)

    return memo[n][W]


n = int(input("Enter number of items: "))

weights = list(map(int, input("Enter weights: ").split()))
profits = list(map(int, input("Enter profits: ").split()))

W = int(input("Enter capacity: "))

bottom_up = knapsack_bottom_up(weights, profits, W)

memo = [[-1] * (W + 1) for _ in range(n + 1)]
top_down = knapsack_top_down(weights, profits, n, W, memo)

print("Maximum profit using Bottom-Up:", bottom_up)
print("Maximum profit using Top-Down:", top_down)
